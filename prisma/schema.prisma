generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id               String            @id @default(cuid())
  name             String
  code             String            @unique
  isActive         Boolean           @default(true)
  isDeleted        Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  departments      Department[]
  letters          Letter[]
  letterRecipients LetterRecipient[]
  users            User[]
  auditLogs        AuditLog[]
}

model Department {
  id               String            @id @default(cuid())
  name             String
  companyId        String
  isDeleted        Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  company          Company           @relation(fields: [companyId], references: [id])
  letters          Letter[]
  letterRecipients LetterRecipient[]
  users            User[]
  referrals        LetterReferral[]

  @@unique([companyId, name])
}

model User {
  id                        String             @id @default(cuid())
  fullName                  String
  username                  String             @unique
  password                  String
  roleId                    String?
  isActive                  Boolean            @default(true)
  companyId                 String
  departmentId              String?
  isDeleted                 Boolean            @default(false)
  deletedAt                 DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @default(now()) @updatedAt
  createdLetters            Letter[]           @relation("Creator")
  receivedLetters           LetterRecipient[]
  department                Department?        @relation(fields: [departmentId], references: [id])
  company                   Company            @relation(fields: [companyId], references: [id])
  roleRelation              Role?              @relation(fields: [roleId], references: [id])
  auditLogs                 AuditLog[]
  sentReferrals             LetterReferral[]   @relation("ReferralSender")
  receivedReferrals         LetterReferral[]   @relation("ReferralTargetUser")
  uploadedLetterAttachments LetterAttachment[] @relation("LetterAttachmentUploader")
}

model Letter {
  id                   String             @id @default(cuid())
  letterNumber         String?
  subject              String
  body                 String?
  type                 LetterType
  status               LetterStatus       @default(DRAFT)
  priority             Priority           @default(NORMAL)
  creatorId            String
  companyId            String
  departmentId         String?
  senderName           String?
  senderOrganization   String?
  receiverName         String?
  receiverOrganization String?
  isDeleted            Boolean            @default(false)
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  department           Department?        @relation(fields: [departmentId], references: [id])
  company              Company            @relation(fields: [companyId], references: [id])
  creator              User               @relation("Creator", fields: [creatorId], references: [id])
  recipients           LetterRecipient[]
  referrals            LetterReferral[]
  attachments          LetterAttachment[]
  auditLogs            AuditLog[]

  @@index([companyId])
  @@index([departmentId])
  @@index([creatorId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  users           User[]
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model LetterRecipient {
  id            String          @id @default(cuid())
  letterId      String
  recipientType RecipientType
  userId        String?
  departmentId  String?
  companyId     String?
  status        RecipientStatus @default(PENDING)
  readAt        DateTime?
  receivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  company       Company?        @relation(fields: [companyId], references: [id])
  department    Department?     @relation(fields: [departmentId], references: [id])
  user          User?           @relation(fields: [userId], references: [id])
  letter        Letter          @relation(fields: [letterId], references: [id])

  @@index([letterId])
  @@index([userId])
  @@index([departmentId])
  @@index([companyId])
  @@index([status])
}

enum LetterType {
  INCOMING
  OUTGOING
  INTERNAL
}

enum LetterStatus {
  DRAFT
  SENT
  RECEIVED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RecipientType {
  USER
  DEPARTMENT
  COMPANY
}

enum RecipientStatus {
  PENDING
  RECEIVED
  READ
  ARCHIVED
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  companyId   String?
  action      String
  entity      String?
  entityId    String?
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user             User?           @relation(fields: [userId], references: [id])
  company          Company?        @relation(fields: [companyId], references: [id])
  letter           Letter?         @relation(fields: [letterId], references: [id])
  letterId         String?
  letterReferral   LetterReferral? @relation(fields: [letterReferralId], references: [id])
  letterReferralId String?

  @@index([userId])
  @@index([companyId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

enum ReferralStatus {
  PENDING
  RECEIVED
  IN_PROGRESS
  DONE
  REJECTED
  CANCELLED
}

enum ReferralTargetType {
  USER
  DEPARTMENT
}

model LetterReferral {
  id String @id @default(cuid())

  letterId String
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("ReferralSender", fields: [senderId], references: [id])

  targetType ReferralTargetType

  targetUserId String?
  targetUser   User?   @relation("ReferralTargetUser", fields: [targetUserId], references: [id])

  targetDepartmentId String?
  targetDepartment   Department? @relation(fields: [targetDepartmentId], references: [id])

  parentId String?
  parent   LetterReferral?  @relation("ReferralChain", fields: [parentId], references: [id])
  children LetterReferral[] @relation("ReferralChain")

  description String?

  rejectionReason    String?
  cancellationReason String?
  completionNote     String?
  priority           Priority @default(NORMAL)

  status      ReferralStatus     @default(PENDING)
  attachments LetterAttachment[]
  auditLogs   AuditLog[]
  dueDate     DateTime?

  receivedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([letterId])
  @@index([senderId])
  @@index([targetUserId])
  @@index([targetDepartmentId])
  @@index([status])
  @@index([parentId])
  @@index([dueDate])
}

enum AttachmentKind {
  LETTER
  REFERRAL
}

model LetterAttachment {
  id String @id @default(cuid())

  letterId String
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)

  referralId String?
  referral   LetterReferral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("LetterAttachmentUploader", fields: [uploadedById], references: [id])

  kind AttachmentKind @default(LETTER)

  originalName String
  storedName   String @unique
  mimeType     String
  size         Int

  createdAt DateTime @default(now())

  @@index([letterId])
  @@index([referralId])
  @@index([uploadedById])
  @@index([kind])
}
